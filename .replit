modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 18441
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
WAITLIST_EXPORT_TOKEN = "a403fb73a2aa51126f828979b293b21b0ce481c1f791372cc9951a69da285f2d"
